---
// 官方管道總表（身分頁版）。
// 這裡是所有官方帳號的正本，分線列出。各線的站只列自己那組，並指回這裡。
// 帳號值都在 consts.ts，這個檔案不寫死任何網址。
import { CHANNELS, EMAIL, GROW_URL, DEV_URL, PROTECT_URL } from '../consts';
const host = (u: string) => u.replace('https://', '');
---

<section class="wrap channels">
  <p class="zone-label">防範冒用</p>
  <h2>我的官方管道，全部在這裡</h2>

  <p class="channels-intro">
    假冒財務顧問和保險業務員的詐騙變多了。以下是我唯一在使用的帳號，依三條線分開列。
    如果你在其他地方看到我的名字或照片，請先對照這裡。
  </p>

  <div class="channel-group">
    <h3>財務教練</h3>
    <ul class="channel-list">
      <li><span>網站</span><a href={GROW_URL}>{host(GROW_URL)}</a></li>
      <li><span>Threads</span><a href={CHANNELS.grow.threads} rel="me">{CHANNELS.grow.handle}</a></li>
      <li><span>Instagram</span><a href={CHANNELS.grow.instagram} rel="me">{CHANNELS.grow.handle}</a></li>
      <li><span>LINE 官方帳號</span><a href={CHANNELS.grow.line}>加入好友</a></li>
    </ul>
  </div>

  <div class="channel-group">
    <h3>保險服務</h3>
    <ul class="channel-list">
      <li><span>網站</span><a href={PROTECT_URL}>{host(PROTECT_URL)}</a></li>
      <li><span>Threads</span><a href={CHANNELS.protect.threads} rel="me">{CHANNELS.protect.handle}</a></li>
      <li><span>Instagram</span><a href={CHANNELS.protect.instagram} rel="me">{CHANNELS.protect.handle}</a></li>
      <li><span>LINE 官方帳號</span><a href={CHANNELS.protect.line}>加入好友</a></li>
    </ul>
  </div>

  <div class="channel-group">
    <h3>軟體開發</h3>
    <ul class="channel-list">
      <li><span>網站</span><a href={DEV_URL}>{host(DEV_URL)}</a></li>
      {CHANNELS.dev.line
        ? <li><span>LINE 官方帳號</span><a href={CHANNELS.dev.line}>加入好友</a></li>
        : <li><span>LINE 官方帳號</span><em style="color:var(--muted);font-style:normal;">籌備中，先用 Email</em></li>}
    </ul>
  </div>

  <div class="channel-group">
    <h3>共用</h3>
    <ul class="channel-list">
      <li><span>Email</span><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
    </ul>
  </div>

  <div class="never-box">
    <h3>我不會做的事</h3>
    <ul>
      <li>不會主動私訊陌生人談投資、財務或保險</li>
      <li>不會用個人 LINE 或上面沒列的帳號聯絡你</li>
      <li>不會要求你匯款到任何帳戶</li>
      <li>不會保證任何投資報酬或保單收益</li>
      <li>不會用「限時」「名額有限」催促你做決定</li>
    </ul>
    <p class="never-note">
      如果有人用我的名字或照片做上述任何一件事，那不是我。
      歡迎直接用上面的管道向我確認。
    </p>
  </div>
</section>

<style>
  .channels { padding-top: 100px; padding-bottom: 100px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 24px; }
  .channels > .zone-label, .channels > h2, .channels > .channels-intro, .channels > .never-box { grid-column: 1 / -1; }
  .zone-label { font-family: var(--f-italic); font-style: italic; color: var(--dev); font-size: 1.1rem; }
  .channels > h2 { font-family: var(--f-display); font-weight: 900; font-size: clamp(1.8rem, 3vw, 2.5rem); margin-top: 4px; }
  .channels-intro { color: var(--muted); margin: 10px 0 24px; max-width: 40rem; padding-bottom: 18px; border-bottom: 2px solid var(--ink); }
  .channel-group { min-width: 0; padding-top: 6px; }
  .channel-group h3 { font-size: 1rem; letter-spacing: .12em; margin-bottom: 10px; color: var(--ink); }
  .channel-group:nth-of-type(1) h3 { color: var(--grow); }
  .channel-group:nth-of-type(2) h3 { color: var(--protect); }
  .channel-group:nth-of-type(3) h3 { color: var(--dev); }
  .channel-list { list-style: none; display: grid; gap: 0; }
  .channel-list li { display: flex; justify-content: space-between; gap: 10px; padding: 9px 0; border-bottom: 1px dotted var(--rule); font-size: .92rem; flex-wrap: wrap; }
  .channel-list span { color: var(--muted); }
  .channel-list a { color: var(--ink); font-weight: 600; text-decoration: none; word-break: break-all; }
  .channel-list a:hover { text-decoration: underline; }
  .never-box { margin-top: 44px; display: grid; grid-template-columns: minmax(0, .6fr) minmax(0, 1.4fr); gap: 12px 28px; background: var(--ink); color: var(--paper); padding: 36px; }
  .never-box h3 { font-family: var(--f-display); font-size: 1.6rem; grid-row: span 2; }
  .never-box ul { list-style: none; display: grid; gap: 8px; }
  .never-box li { padding-left: 22px; position: relative; }
  .never-box li::before { content: "×"; position: absolute; left: 0; color: #F08A70; font-weight: 700; }
  .never-note { font-weight: 600; line-height: 1.7; color: var(--paper); }
  @media (max-width: 860px) {
    .channels { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 24px; }
    .never-box { grid-template-columns: minmax(0, 1fr); padding: 28px 22px; }
    .never-box h3 { grid-row: auto; }
  }
  @media (max-width: 560px) { .channels { grid-template-columns: minmax(0, 1fr); } }
</style>

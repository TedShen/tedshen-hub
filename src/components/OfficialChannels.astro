---
// 官方管道總表（身分頁版）。
// 這裡是所有官方帳號的正本，分線列出。各線的站只列自己那組，並指回這裡。
// 帳號值都在 consts.ts，這個檔案不寫死任何網址。
import { CHANNELS, EMAIL, GROW_URL, DEV_URL } from '../consts';
const host = (u: string) => u.replace('https://', '');
---

<section class="wrap channels">
  <p class="zone-label">防範冒用</p>
  <h2>我的官方管道，全部在這裡</h2>

  <p class="channels-intro">
    假冒財務顧問和保險業務員的詐騙變多了。以下是我唯一在使用的帳號，依三條線分開列。
    如果你在其他地方看到我的名字或照片，請先對照這裡。
  </p>

  <div class="channel-group">
    <h3>財務教練</h3>
    <ul class="channel-list">
      <li><span>網站</span><a href={GROW_URL}>{host(GROW_URL)}</a></li>
      <li><span>Threads</span><a href={CHANNELS.grow.threads} rel="me">{CHANNELS.grow.handle}</a></li>
      <li><span>Instagram</span><a href={CHANNELS.grow.instagram} rel="me">{CHANNELS.grow.handle}</a></li>
      <li><span>LINE 官方帳號</span><a href={CHANNELS.grow.line}>加入好友</a></li>
    </ul>
  </div>

  <div class="channel-group">
    <h3>保險服務</h3>
    <ul class="channel-list">
      <li><span>Threads</span><a href={CHANNELS.protect.threads} rel="me">{CHANNELS.protect.handle}</a></li>
      <li><span>Instagram</span><a href={CHANNELS.protect.instagram} rel="me">{CHANNELS.protect.handle}</a></li>
      <li><span>LINE 官方帳號</span><a href={CHANNELS.protect.line}>加入好友</a></li>
    </ul>
  </div>

  <div class="channel-group">
    <h3>軟體開發</h3>
    <ul class="channel-list">
      <li><span>網站</span><a href={DEV_URL}>{host(DEV_URL)}</a></li>
      {CHANNELS.dev.line
        ? <li><span>LINE 官方帳號</span><a href={CHANNELS.dev.line}>加入好友</a></li>
        : <li><span>LINE 官方帳號</span><em style="color:var(--muted);font-style:normal;">籌備中，先用 Email</em></li>}
    </ul>
  </div>

  <div class="channel-group">
    <h3>共用</h3>
    <ul class="channel-list">
      <li><span>Email</span><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
    </ul>
  </div>

  <div class="never-box">
    <h3>我不會做的事</h3>
    <ul>
      <li>不會主動私訊陌生人談投資、財務或保險</li>
      <li>不會用個人 LINE 或上面沒列的帳號聯絡你</li>
      <li>不會要求你匯款到任何帳戶</li>
      <li>不會保證任何投資報酬或保單收益</li>
      <li>不會用「限時」「名額有限」催促你做決定</li>
    </ul>
    <p class="never-note">
      如果有人用我的名字或照片做上述任何一件事，那不是我。
      歡迎直接用上面的管道向我確認。
    </p>
  </div>
</section>

<style>
  .channels-intro { margin-bottom: 24px; }
  .channel-group { margin-bottom: 24px; }
  .channel-group h3 { font-size: .95rem; color: var(--brand); letter-spacing: .05em; margin-bottom: 10px; }
  .channel-list { list-style: none; display: grid; gap: 10px; }
  .channel-list li {
    display: flex; align-items: baseline; gap: 12px; padding: 12px 18px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    font-size: .96rem; flex-wrap: wrap;
  }
  .channel-list span { color: var(--muted); font-size: .85rem; min-width: 104px; }
  .channel-list a { color: var(--brand); text-decoration: none; font-weight: 600; word-break: break-all; }
  .channel-list a:hover { text-decoration: underline; }
  .never-box {
    margin-top: 32px;
    background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--brand);
    border-radius: 12px; padding: 24px;
  }
  .never-box h3 { font-size: 1.05rem; margin-bottom: 14px; }
  .never-box ul { list-style: none; display: grid; gap: 8px; margin-bottom: 18px; }
  .never-box li { color: var(--muted); font-size: .95rem; padding-left: 22px; position: relative; }
  .never-box li::before { content: "×"; position: absolute; left: 0; color: var(--brand); font-weight: 700; }
  .never-note { font-size: .95rem; color: var(--text); font-weight: 600; line-height: 1.7; }
</style>

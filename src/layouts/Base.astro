---
import { SITE_NAME, SITE_URL, SITE_DESCRIPTION, PERSON, EMAIL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  /** 相對路徑，例如 "/blog/"。用來組 og:url 與 canonical；沒尾斜線會自動補。 */
  path?: string;
  /** 分享預覽圖，相對路徑；預設 /og.jpg（1200×630）。單篇文章有專圖時可覆寫。 */
  image?: string;
  /** 文章頁傳 'article'，其餘預設 'website'。 */
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** 麵包屑，不含首頁（會自動加在最前面）。例：[{ name: '部落格', path: '/blog/' }] */
  breadcrumbs?: { name: string; path: string }[];
  /** 額外 JSON-LD（Person、BlogPosting 等），見 src/lib/schema.ts。 */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  ogTitle,
  ogDescription,
  path = '/',
  image = '/og.jpg',
  type = 'website',
  publishedTime,
  modifiedTime,
  breadcrumbs = [],
  schema,
} = Astro.props;

// GitHub Pages 實際服務的是 /path/，沒尾斜線的網址會 301。canonical 必須指向最終網址。
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const canonical = new URL(withSlash(path), SITE_URL).href;
const ogImage = new URL(image, SITE_URL).href;

const breadcrumbLd =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: '首頁', path: '/' }, ...breadcrumbs].map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: new URL(withSlash(b.path), SITE_URL).href,
        })),
      }
    : null;
const schemas = [
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
  ...(breadcrumbLd ? [breadcrumbLd] : []),
];
---

<!DOCTYPE html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    <!-- Open Graph：分享到 LINE / FB 時的預覽 -->
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {image === '/og.jpg' && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content={`${PERSON.name} ${PERSON.alternateName}，${PERSON.jobTitle}`} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="zh_TW" />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {type === 'article' && <meta property="article:author" content={PERSON.name} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 結構化資料：Person / WebSite / BlogPosting / BreadcrumbList，由各頁透過 props 傳入 -->
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;700;900&family=Noto+Sans+TC:wght@400;500;700&family=Fraunces:ital,opsz,wght@1,9..144,400;1,9..144,600&display=swap" />
    <meta name="theme-color" content="#F3EFE7" />

    <style is:global>
      /* 版型：雜誌封面＋目錄。只做淺色（像印刷紙），刻意不跟系統深色模式切換。
         三條線各一個顏色：軟體紅、財務綠、保險藍，其他站沿用同一組色票當入口標示。 */
      :root {
        --paper: #F3EFE7;
        --paper-2: #E9E3D7;
        --ink: #1A1714;
        --muted: #6C655B;
        --dev: #C93E26;
        --grow: #2E6B4E;
        --protect: #1E3A63;
        --rule: rgba(26, 23, 20, .16);
        --f-display: "Noto Serif TC", "Songti TC", serif;
        --f-body: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", system-ui, sans-serif;
        --f-italic: "Fraunces", Georgia, serif;
        color-scheme: light;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { font-family: var(--f-body); background: var(--paper); color: var(--ink); line-height: 1.8; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--dev); outline-offset: 3px; }
      img { max-width: 100%; }
      h1, h2, h3 { text-wrap: balance; }
      .wrap { max-width: 1180px; margin: 0 auto; padding-left: max(20px, env(safe-area-inset-left, 0px)); padding-right: max(20px, env(safe-area-inset-right, 0px)); }
      .h-display { font-family: var(--f-display); font-weight: 900; font-size: clamp(1.9rem, 3.6vw, 3rem); line-height: 1.35; }
      .label-italic { font-family: var(--f-italic); font-style: italic; color: var(--muted); font-size: 1.1rem; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

      .site-foot { position: relative; color: #F3EFE7; background: #101826; overflow: hidden; }
      .site-foot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .42; max-width: none; }
      .site-foot .wrap { position: relative; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 18px; padding-top: 96px; padding-bottom: calc(32px + env(safe-area-inset-bottom, 0px)); }
      .site-foot b { font-family: var(--f-display); font-weight: 900; font-size: 2rem; display: block; }
      .site-foot nav { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: .9rem; margin-top: 8px; }
      .site-foot a { color: #F3EFE7; }
      .site-foot small { font-size: .78rem; opacity: .75; }
    </style>
  </head>
  <body>
    <slot />

    <footer class="site-foot">
      <img src="/img/taipei-night.webp" alt="" width="1800" height="1200" loading="lazy" />
      <div class="wrap">
        <div>
          <b>沈裕德 Ted</b>
          <nav aria-label="網站導覽">
            <a href="/">tedshen.link</a><a href="https://dev.tedshen.link/">軟體開發</a><a href="https://grow.tedshen.link/">財務教練</a><a href="https://protect.tedshen.link/">保險服務</a>
          </nav>
          <p style="margin-top:8px;font-size:.9rem;">聯絡：<a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
        </div>
        <small>夜景攝影：Timo Volz／Unsplash</small>
      </div>
    </footer>
  </body>
</html>
